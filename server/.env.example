# Copy to .env if you use a process manager that loads it (this project
# doesn't load .env itself — plain process.env, set these however your
# host expects: shell export, Replit Secrets, Render/Railway env vars, etc.)

# Port the HTTP + WebSocket server listens on. Most hosts (Replit, Render,
# Railway, Heroku) inject this themselves; only set it locally if you want
# something other than 3001.
PORT=3001
