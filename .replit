run = "npm run install:all && npm run build && npm start"
entrypoint = "server/src/index.js"

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 3001
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm run install:all && npm run build && npm rebuild better-sqlite3 --build-from-source --prefix server"]
run = ["sh", "-c", "npm start"]
